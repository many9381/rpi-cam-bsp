+  GstRTSPSession* session = gst_rtsp_session_pool_create(pool);
+  GstRTSPClient* client = gst_rtsp_client_new();
+  gst_rtsp_client_set_session_pool(client, pool);
+  gst_rtsp_client_set_auth(client, auth.get());
