Subject: [PATCH] avformat/hls: release detached segments on parse failure

FFmpeg 7.1 detaches the previous segment list before parsing a playlist
reload. Its common failure path does not own that list, so rejecting a
Master Playlist tag during reload loses the old allocations even after
the HLS context is closed. Move cleanup to the common exit path; keep
timestamp updates on the successful path and leave pre-detachment failures
with their original playlist ownership.

Upstream-Status: Pending
---
 libavformat/hls.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/libavformat/hls.c b/libavformat/hls.c
--- a/libavformat/hls.c
+++ b/libavformat/hls.c
@@ -1114,13 +1114,15 @@ static int parse_playlist(HLSContext *c, const char *url,
             av_log(c->ctx, AV_LOG_WARNING, "Media sequence changed unexpectedly: %"PRId64" -> %"PRId64"\n",
                    prev_start_seq_no, pls->start_seq_no);
         }
-        free_segment_dynarray(prev_segments, prev_n_segments);
-        av_freep(&prev_segments);
     }
     if (pls)
         pls->last_load_time = av_gettime_relative();
 
 fail:
+    if (prev_segments) {
+        free_segment_dynarray(prev_segments, prev_n_segments);
+        av_freep(&prev_segments);
+    }
     av_free(new_url);
     if (close_in)
         ff_format_io_close(c->ctx, &in);
