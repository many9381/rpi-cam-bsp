[Unit]
Description=Camera network security policy
DefaultDependencies=no
Requires=systemd-modules-load.service systemd-sysctl.service
After=systemd-modules-load.service systemd-sysctl.service
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=@SBINDIR@/nft --file @DATADIR@/rpi5-security-policy/firewall.nft
ExecReload=@SBINDIR@/nft --file @DATADIR@/rpi5-security-policy/firewall.nft
# Keep rules installed on stop and until the network namespace is destroyed.

[Install]
WantedBy=multi-user.target
