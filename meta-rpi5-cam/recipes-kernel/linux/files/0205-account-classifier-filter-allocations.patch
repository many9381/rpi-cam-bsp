From: Kernel Security Follow-up <kernel-security@local>
Subject: [PATCH] account classifier filter allocations

CVE: CVE-2026-90099
Upstream: https://git.kernel.org/stable/c/18c68c8f3d3ff0a4def1391021b439c4333a6c71
Upstream-Status: Backport [https://git.kernel.org/stable/c/18c68c8f3d3ff0a4def1391021b439c4333a6c71]

Use retained kzalloc/kcalloc APIs rather than newer object-allocation
wrappers; carry GFP_KERNEL_ACCOUNT through all upstream filter and aux
sites, including u32 replace. Use existing percpu GFP variants. Roll
back a newly inserted basic IDR entry when percpu allocation fails while
preserving an existing replacement handle.

diff --git a/net/sched/cls_api.c b/net/sched/cls_api.c
--- a/net/sched/cls_api.c
+++ b/net/sched/cls_api.c
@@ -3373,7 +3373,7 @@
 	 */
 	exts->net = net;
 	exts->actions = kcalloc(TCA_ACT_MAX_PRIO, sizeof(struct tc_action *),
-				GFP_KERNEL);
+				GFP_KERNEL_ACCOUNT);
 	if (!exts->actions)
 		return -ENOMEM;
 #endif
diff --git a/net/sched/cls_basic.c b/net/sched/cls_basic.c
--- a/net/sched/cls_basic.c
+++ b/net/sched/cls_basic.c
@@ -193,7 +193,7 @@
 			return -EINVAL;
 	}
 
-	fnew = kzalloc(sizeof(*fnew), GFP_KERNEL);
+	fnew = kzalloc(sizeof(*fnew), GFP_KERNEL_ACCOUNT);
 	if (!fnew)
 		return -ENOBUFS;
 
@@ -212,9 +212,11 @@
 	if (err)
 		goto errout;
 	fnew->handle = handle;
-	fnew->pf = alloc_percpu(struct tc_basic_pcnt);
+	fnew->pf = alloc_percpu_gfp(struct tc_basic_pcnt, GFP_KERNEL_ACCOUNT);
 	if (!fnew->pf) {
 		err = -ENOMEM;
+		if (!fold)
+			idr_remove(&head->handle_idr, fnew->handle);
 		goto errout;
 	}
 
