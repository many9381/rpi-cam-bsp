From: Kernel Security Follow-up <kernel-security@local>
Subject: [PATCH] preserve fastcall patterns with incoming jumps

CVE: CVE-2026-98048
Upstream: https://git.kernel.org/stable/c/24adbc2c3bbe3385ce922587e1f8e837a68b3e25
Upstream-Status: Backport [https://git.kernel.org/stable/c/24adbc2c3bbe3385ce922587e1f8e837a68b3e25]

Retained CFG routines reside in verifier.c. Mark conditional and direct
subprogram/function edges at push_insn(BRANCH) and both JMP/JMP32 JA targets
at visit_insn. This source rejects register-source JA, so no gotox path
exists. Keep jmp_point independent to preserve legitimate call returns.

diff --git a/include/linux/bpf_verifier.h b/include/linux/bpf_verifier.h
--- a/include/linux/bpf_verifier.h
+++ b/include/linux/bpf_verifier.h
@@ -571,6 +571,8 @@
 	/* below fields are initialized once */
 	unsigned int orig_idx; /* original instruction index */
 	bool jmp_point;
+	/* Instruction reached by a direct jump or call edge. */
+	bool jump_target;
 	bool prune_point;
 	/* ensure we check state equivalence and save state checkpoint and
 	 * this instruction, regardless of any heuristics
diff --git a/kernel/bpf/verifier.c b/kernel/bpf/verifier.c
--- a/kernel/bpf/verifier.c
+++ b/kernel/bpf/verifier.c
@@ -17956,6 +17956,16 @@
 	env->insn_aux_data[idx].prune_point = true;
 }
 
+static void mark_jump_target(struct bpf_verifier_env *env, int idx)
+{
+	env->insn_aux_data[idx].jump_target = true;
+}
+
+static bool bpf_is_jump_target(struct bpf_verifier_env *env, int idx)
+{
+	return env->insn_aux_data[idx].jump_target;
+}
+
 static bool is_prune_point(struct bpf_verifier_env *env, int insn_idx)
 {
 	return env->insn_aux_data[insn_idx].prune_point;
@@ -18012,6 +18022,7 @@
 		/* mark branch target for state pruning */
 		mark_prune_point(env, w);
 		mark_jmp_point(env, w);
+		mark_jump_target(env, w);
 	}
 
 	if (insn_state[w] == 0) {
@@ -18244,6 +18255,10 @@
 	for (i = 1, off = lowest_off; i <= ARRAY_SIZE(caller_saved); ++i, off += BPF_REG_SIZE) {
 		if (insn_idx - i < 0 || insn_idx + i >= env->prog->len)
 			break;
+		/* Entering at the first spill is safe; interior entries are not. */
+		if (bpf_is_jump_target(env, insn_idx - i + 1) ||
+		    bpf_is_jump_target(env, insn_idx + i))
+			break;
 		stx = &insns[insn_idx - i];
 		ldx = &insns[insn_idx + i];
 		/* must be a stack spill/fill pair */
@@ -18429,6 +18444,7 @@
 
 		mark_prune_point(env, t + off + 1);
 		mark_jmp_point(env, t + off + 1);
+		mark_jump_target(env, t + off + 1);
 
 		return ret;
 
