# Provision app.yaml as root:camera-firmware, mode 0640, before starting.
# Replace the origin, provision per-device TLS and SRTP material, and sign an
# integrity manifest for the installed binary, final app.yaml and boot kernel.
# The build must embed your Ed25519 PUBLIC key; keep its private key off-device.
# State and generated credentials are owned by camera-firmware with mode 0700
# directories / 0600 files. TLS certificate AND key must be regular files owned
# by camera-firmware (no symlinks/hardlinks): key 0600, certificate 0600 or 0644.
platform:
  target: rpi5

camera:
  id: imx708-main
  source:
    backend: libcamera
    camera_index: 0
  video:
    width: 1920
    height: 1080
    fps: 50
    format: nv12
  encoder:
    backend: x264
    bitrate_kbps: 6000
    gop: 13
    preset: ultrafast
  ai:
    enabled: false
    model_ids: []

http:
  enabled: true
  bind_ip: 0.0.0.0
  port: 8443
  web_root: '@DATADIR@/camera-firmware/web'
  public_base_url: https://camera.example.invalid:8443
  snapshot:
    stale_timeout_ms: 2000
  live:
    enabled: true
    fragment_duration_ms: 250
    max_clients: 4
    ring_fragments: 8
    stale_timeout_ms: 2000
  tls:
    enabled: true
    allow_development_self_signed_tls: false
    certificate_path: '@SYSCONFDIR@/camera-firmware/tls/device.crt'
    private_key_path: '@SYSCONFDIR@/camera-firmware/tls/device.key'

security:
  enabled: true
  state_directory: /var/lib/camera-firmware/security
  audit:
    max_events: 50000
    warning_percent: 90

self_protection:
  manifest_path: '@SYSCONFDIR@/camera-firmware/integrity/manifest.yaml'
  signature_path: '@SYSCONFDIR@/camera-firmware/integrity/manifest.sig'
  interval_hours: 24

# To enable Hailo, build with the Hailo profile and provision reviewed HEF files
# plus the model catalog required by the upstream application configuration.
ai:
  enabled: false
  backend: disabled
  models: []

secure_rtsp:
  enabled: true
  control_tls: true
  keying: sdes-over-rtsps
  allow_development_self_signed_tls: false
  tls_certificate_path: '@SYSCONFDIR@/camera-firmware/tls/device.crt'
  tls_private_key_path: '@SYSCONFDIR@/camera-firmware/tls/device.key'
  media_srtp: true
  bind_ip: 0.0.0.0
  port: 8555
  mount: /imx708/main
  client_auth:
    enabled: true
    realm: rpi-camera
    credential_file: /var/lib/camera-firmware/security/rtsp-digest.credentials
    algorithms: [sha-256]
    nonce_ttl_seconds: 300
  session_key:
    source: file
    path: '@SYSCONFDIR@/camera-firmware/srtp-session.hex'
    encoding: hex
    zeroize_on_reload: true
