[Unit]
Description=Camera firmware with HTTPS and secure RTSP
Wants=network-online.target
After=network-online.target
ConditionPathExists=@SYSCONFDIR@/camera-firmware/app.yaml

[Service]
Type=simple
User=camera-firmware
Group=camera-firmware
SupplementaryGroups=video render
WorkingDirectory=/var/lib/camera-firmware
StateDirectory=camera-firmware
StateDirectoryMode=0700
UMask=0077
ExecStart=@BINDIR@/camera-firmware @SYSCONFDIR@/camera-firmware/app.yaml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictSUIDSGID=true
# Camera/DRM/Hailo devices and the kernel image used by integrity verification
# must remain accessible. Do not enable PrivateDevices or ProtectKernelModules.

[Install]
WantedBy=multi-user.target
